{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PackDrive",
  "version": "1.0.0",
  "identifier": "com.caiosilva.packdrive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PackDrive",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNzQ4OTdBNkJFODhGNTYKUldSV2oraHJlb2wwSUFDczNaeStZenVjMTUzbVRkNzhwb2lNV2ZGY3JJeFF0R1BDSEVRVWxkU1AK",
      "endpoints": [
        "https://github.com/galaxyhf/PackDrive/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
